+        kind="observation",
+        recorded_at=VECTOR_RECORDED,
+        occurred_at=VECTOR_OCCURRED,
+        prev_hash=VECTOR_PREV,
+        payload_digest=DIGEST,
+        units_digest=UNITS_DIGEST,
+        source="email",
+        external_id="nachricht-1",
+    )
+    assert first != second
